# ===== PostgreSQL =====
# Compose connects to host `db` (the service name). Local dev (`make dev`) uses `localhost`.
DATABASE_URL=postgres://kairos:change-me@db:5432/kairos?sslmode=disable
# Keep POSTGRES_* consistent with the DATABASE_URL above.
POSTGRES_USER=kairos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kairos

# ===== Authentication =====
# JWT_SECRET must be at least 32 bytes. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes
# Single account username.
APP_USER=admin
# bcrypt hash of the login password. Generate: make gen-password PASSWORD=your-password
APP_PASSWORD_HASH=replace_with_bcrypt_hash_from_make_gen_password

# ===== API server =====
KAIROS_API_PORT=8080
# In-container data dir for AI key files and the sync DEK; mounted from the `ai_data` volume.
KAIROS_DATA_DIR=/data

# ===== SMTP notifications (optional; leave SMTP_HOST empty to disable) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Kairos <no-reply@kairos.local>"
SMTP_TO=
SMTP_TLS=starttls
