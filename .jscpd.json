{
  "minTokens": 30,
  "minLines": 5,
  "format": ["rust", "typescript", "javascript"],
  "ignore": [
    "**/node_modules/**",
    "**/target/**",
    "**/dist/**",
    "**/dist-ssr/**",
    "**/src-tauri/gen/**",
    "**/.git/**",
    "**/.idea/**",
    "**/.vscode/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/.codex/**",
    "**/.reasonix/**",
    "**/.trellis/tasks/**",
    "**/.trellis/workspace/**",
    "**/_ui_temp_figs/**",
    "**/_TEMP/**",
    "**/logs/**",
    "**/*.log",
    "**/*.local",
    "**/*.min.js",
    "**/.env",
    "**/.env.*",
    "**/*.pem",
    "**/*.key",
    "**/*.jks",
    "**/*.pfx",
    "**/*.p12",
    "**/*.cer",
    "**/*.crt",
    "**/*.keystore"
  ],
  "reporters": ["console"],
  "output": "report/jscpd",
  "threshold": 5,
  "blame": false
}