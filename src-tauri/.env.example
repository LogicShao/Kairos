# LZU 协议密钥已内置为代码常量（src-tauri/src/lzu/crypto.rs 的 AES_KEY、
# src-tauri/src/lzu/easytong.rs 的 MD5_KEY），不再从环境变量或 .env.local 读取。
#
# 此文件仅为历史参考，保留占位说明以便理解原设计：
# （原用途）后端专用 LZU AppService AES key，16 字节 UTF-8。
KAIROS_LZU_AES_KEY=replace_16_bytes

# （原用途）EasyTong/一卡通余额功能使用的 MD5 key。
KAIROS_LZU_MD5_KEY=replace_with_authorized_value